# Flask Secret Key for session signing
SECRET_KEY=dev-secret-key-student-tracker-2026-btech

# MongoDB Connection String (Atlas URI or Local MongoDB)
# For MongoDB Atlas, use: mongodb+srv://<username>:<password>@cluster0.mongodb.net/student_tracker?retryWrites=true&w=majority
# For Local MongoDB, use: mongodb://localhost:27017/student_tracker
# Note: If no live MongoDB service is reachable, the application gracefully initializes an in-memory mock store for demo/testing
MONGO_URI=mongodb://localhost:27017/student_tracker
DATABASE_NAME=student_tracker

# Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
ATTENDANCE_LOW_THRESHOLD=75
PORT=5000
